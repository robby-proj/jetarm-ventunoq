[Unit]
Description=App Lab JetArm Tracking Bridge
After=network-online.target jetarm-ros-controller.service
Wants=network-online.target
Requires=jetarm-ros-controller.service

[Service]
Type=simple
User=hiwonder
WorkingDirectory=/home/hiwonder/jetarm_ros2_ws
Environment=HOME=/home/hiwonder
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source /home/hiwonder/jetarm_ros2_ws/install/setup.bash && exec python3 /home/hiwonder/jetarm_ros2_ws/app_lab_ros_bridge.py --ros-args --params-file /home/hiwonder/jetarm_ros2_ws/config/face_tracker.yaml'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
